# ============================================================================
# Maya Trading System — Environment Configuration
# Copy to `.env` and edit. NEVER commit your real .env file.
# ============================================================================

# ---- Venue ----------------------------------------------------------------
# hyperliquid : on-chain perps via your wallet + an agent key (DEFAULT)
# binance     : Binance USD-M futures via API key
MAYA_VENUE=hyperliquid

# ---- Run mode -------------------------------------------------------------
# sim     : fully self-contained simulation with synthetic data (DEFAULT, no keys needed)
# paper   : real market data, simulated (paper) order execution
# testnet : exchange TESTNET — real sandbox orders, fake money
#           (Hyperliquid testnet, or Binance USD-M futures testnet)
# live    : REAL MONEY (Hyperliquid mainnet / Binance). Requires opt-in below.
MAYA_MODE=sim

# Trading symbol & timeframe. For Hyperliquid the coin is derived from this
# (BTCUSDT -> BTC). Timeframe: 1m / 5m / 15m.
MAYA_SYMBOL=BTCUSDT
MAYA_TIMEFRAME=1m

# How many candles to run before stopping (0 = run forever)
MAYA_MAX_CANDLES=200

# Starting account equity for sim/paper accounting (USDT)
MAYA_START_EQUITY=1000

# ---- LIVE TRADING SAFETY INTERLOCK ----------------------------------------
# Live trading is refused unless this is set to the exact string: I_UNDERSTAND_THE_RISK
MAYA_LIVE_CONFIRM=

# ---- Hyperliquid (default venue) ------------------------------------------
# Your MAIN wallet address (public, 0x...) — what holds the funds / positions.
HYPERLIQUID_ACCOUNT_ADDRESS=
# An AGENT / API wallet private key that signs orders but CANNOT withdraw.
# Approve it ONCE from your main wallet (app.hyperliquid.xyz -> API, or the
# SDK's approve_agent). NEVER put your main seed phrase or withdrawal key here.
# Use testnet (app.hyperliquid-testnet.xyz) first.
HYPERLIQUID_AGENT_KEY=

# ---- Binance API credentials (only when MAYA_VENUE=binance) ----------------
# Use a key with FUTURES permission ONLY. Never enable withdrawals. IP-whitelist it.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Optional LLM confluence / veto layer (Layer 3.4) ---------------------
# When true, an LLM acts as a final veto on trades that already passed the rules.
# It can only REJECT trades, never originate them.
MAYA_LLM_ENABLED=false
ANTHROPIC_API_KEY=
MAYA_LLM_MODEL=claude-sonnet-4-6

# ---- Telegram monitoring / control (Layer 7) ------------------------------
# When enabled, Maya sends trade/halt alerts and accepts commands
# (/status /halt /resume /close_all /stats /risk) from the configured chat.
# Create a bot with @BotFather; get your chat id from @userinfobot.
MAYA_TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Logging --------------------------------------------------------------
MAYA_LOG_LEVEL=INFO
