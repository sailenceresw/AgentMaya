# ============================================================================
# Maya Trading System — Environment Configuration
# Copy to `.env` and edit. NEVER commit your real .env file.
# ============================================================================

# ---- Run mode -------------------------------------------------------------
# sim     : fully self-contained simulation with synthetic data (DEFAULT, no keys needed)
# paper   : real Binance market data, simulated (paper) order execution
# testnet : Binance USD-M Futures TESTNET — real sandbox orders, fake money
# live    : REAL MONEY on Binance USD-M Futures. Requires explicit opt-in below.
MAYA_MODE=sim

# Trading symbol & timeframe
MAYA_SYMBOL=BTCUSDT
MAYA_TIMEFRAME=1m

# How many candles to run before stopping (0 = run forever)
MAYA_MAX_CANDLES=200

# Starting account equity for sim/paper accounting (USDT)
MAYA_START_EQUITY=1000

# ---- Execution venue ------------------------------------------------------
# binance     : Binance USD-M perps via ccxt, using the API keys below (default,
#               and the only path with real testing behind it)
# hyperliquid : Hyperliquid perps via the MetaMask Agent Wallet `mm` CLI.
#               Self-custodial — needs NO exchange API keys, but does need
#               `mm login` and a funded Hyperliquid sub-account.
#               A MetaMask wallet cannot trade Binance and vice versa.
#               Read docs/RUNNING.md before using: SL/TP is not atomic with
#               entry, fill prices are estimated, and the CLI was measured at
#               24-51s per call — long enough to matter on a 1m timeframe.
MAYA_VENUE=binance

# ---- Position sizing & leverage -------------------------------------------
# margin : commit MAYA_MARGIN_PER_TRADE_USD of collateral at MAYA_LEVERAGE, so
#          notional = margin x leverage. Leverage sets your position size.
# risk   : size so that a stop-out loses exactly MAYA_RISK_PER_TRADE_USD.
#          Position size comes from the stop distance, and leverage then
#          affects only how much margin is locked — never your P&L.
MAYA_SIZING_MODE=margin
MAYA_MARGIN_PER_TRADE_USD=20
MAYA_RISK_PER_TRADE_USD=20

# Leverage used for orders. Rejected (not clamped) above RiskLimits.MAX_LEVERAGE=20.
# At 20x with a 0.7% stop, liquidation sits at a 4.5% adverse move — the stop
# uses ~16% of that buffer.
MAYA_LEVERAGE=20

# Minimum expected ROI **on margin** (price move x leverage), not the raw price
# move. Screening the unleveraged move against 40% rejected every realistic 1m
# scalp — BTC does not move 40% intraday. Note this makes the gate
# leverage-dependent: the same setup can clear 40% at 20x but not at 5x.
MAYA_MIN_ROI_PCT=40

# ---- Hyperliquid tuning (only when MAYA_VENUE=hyperliquid) ----------------
# limit enters at the strategy's entry price, preserving planned R:R;
# market fills immediately and silently changes it.
MAYA_PERPS_ORDER_TYPE=limit
# Venue size precision. 5 is correct for BTC — check `mm perps markets` first
# for anything else; Hyperliquid rejects orders with too many size decimals.
MAYA_PERPS_SIZE_DECIMALS=5
MAYA_PERPS_MAX_SLIPPAGE_BPS=50
# Per-`mm`-call timeout. Generous because each call spawns Node and may wait
# on wallet signing/MFA; a timeout leaves order state genuinely UNKNOWN.
MAYA_MM_TIMEOUT_S=120

# ---- Real-time data (optional) ---------------------------------------------
# false (default): REST polling via ccxt, boundary-aligned (maya/data/scheduler.py)
# true: subscribe to Binance kline + aggTrade WebSocket streams directly
#       (opt-in — see docs/RUNNING.md "Real-time WebSocket feed")
MAYA_USE_WEBSOCKET=false

# ---- Backtesting (python -m maya.backtest.runner) --------------------------
# ISO dates for the historical range to fetch/replay. Uses MAYA_SYMBOL /
# MAYA_TIMEFRAME above. Historical klines are cached to CSV under data/.
MAYA_BACKTEST_START=2025-01-01
MAYA_BACKTEST_END=2025-12-31

# ---- LIVE TRADING SAFETY INTERLOCK ----------------------------------------
# Live trading is refused unless this is set to the exact string: I_UNDERSTAND_THE_RISK
MAYA_LIVE_CONFIRM=

# ---- Binance API credentials (only needed for paper/testnet/live) ---------
# Use a key with FUTURES permission ONLY. Never enable withdrawals. IP-whitelist it.
# Before running the agent itself, sanity-check these with:
#   python -m maya.check_connection
# (read-only: checks keys, clock sync, balance, position mode — places no orders)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Optional LLM confluence / veto layer (Layer 3.4) ---------------------
# When true, an LLM acts as a final veto on trades that already passed the rules.
# It can only REJECT trades, never originate them.
MAYA_LLM_ENABLED=false
ANTHROPIC_API_KEY=
MAYA_LLM_MODEL=claude-sonnet-4-6

# ---- Logging --------------------------------------------------------------
MAYA_LOG_LEVEL=INFO
