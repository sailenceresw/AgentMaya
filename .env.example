# ============================================================================
# Maya Trading System — Environment Configuration
# Copy to `.env` and edit. NEVER commit your real .env file.
# ============================================================================

# ---- Run mode -------------------------------------------------------------
# sim     : fully self-contained simulation with synthetic data (DEFAULT, no keys needed)
# paper   : real Binance market data, simulated (paper) order execution
# testnet : Binance USD-M Futures TESTNET — real sandbox orders, fake money
# live    : REAL MONEY on Binance USD-M Futures. Requires explicit opt-in below.
MAYA_MODE=sim

# Trading symbol & timeframe
MAYA_SYMBOL=BTCUSDT
MAYA_TIMEFRAME=1m

# How many candles to run before stopping (0 = run until stopped). Leave unset
# for the default: 200 in sim mode, unlimited with real market data — so a
# paper/testnet/live run never stops (and flattens) on its own.
# MAYA_MAX_CANDLES=200

# Starting account equity for sim/paper accounting (USDT)
MAYA_START_EQUITY=1000

# ---- Execution venue ------------------------------------------------------
# binance     : Binance USD-M perps via ccxt, using the API keys below (default,
#               and the only path with real testing behind it)
# hyperliquid : Hyperliquid perps via the MetaMask Agent Wallet `mm` CLI.
#               Self-custodial — needs NO exchange API keys, but does need
#               `mm login` and a funded Hyperliquid sub-account.
#               A MetaMask wallet cannot trade Binance and vice versa.
#               Read docs/RUNNING.md before using: SL/TP is not atomic with
#               entry, fill prices are estimated, and the CLI was measured at
#               24-51s per call — long enough to matter on a 1m timeframe.
MAYA_VENUE=binance

# ---- Position sizing & leverage -------------------------------------------
# margin : commit MAYA_MARGIN_PER_TRADE_USD of collateral at MAYA_LEVERAGE, so
#          notional = margin x leverage. Leverage sets your position size.
# risk   : size so that a stop-out loses exactly MAYA_RISK_PER_TRADE_USD.
#          Position size comes from the stop distance, and leverage then
#          affects only how much margin is locked — never your P&L.
# risk_pct: size so that a stop-out loses MAYA_RISK_PER_TRADE_PCT of current
#          equity. Use this on a small account.
# Whatever the mode, one stop-out never risks more than 3% of equity or $20,
# whichever is smaller, and notional never exceeds 10x equity.
MAYA_SIZING_MODE=margin
MAYA_MARGIN_PER_TRADE_USD=20
MAYA_RISK_PER_TRADE_USD=20
MAYA_RISK_PER_TRADE_PCT=3

# A $10 account at 10x (a $100 position at most):
#   MAYA_START_EQUITY=10
#   MAYA_SIZING_MODE=risk_pct
#   MAYA_RISK_PER_TRADE_PCT=3
#   MAYA_LEVERAGE=10
# One round trip on $100 costs $0.10 at Binance taker rates and up to $0.26
# through MetaMask, against $0.30 of risk. Maya logs a fee-drag warning when
# a round trip costs more than 1% of equity; the warning does not block.

# Profit protection. Once a close is this far in favour (percent), the stop
# moves to breakeven plus fees.
MAYA_PROFIT_LOCK_TRIGGER_PCT=0.6
# After the lock: off (default, no trail), pct (trail MAYA_PROFIT_TRAIL_PCT
# percent behind the best price) or r (trail MAYA_PROFIT_TRAIL_R x the initial
# stop distance, once MAYA_PROFIT_TRAIL_START_R x that distance in profit).
# A tight pct trail closes winners long before a 1:4 target. r is unmeasured.
MAYA_PROFIT_TRAIL_MODE=off
MAYA_PROFIT_TRAIL_PCT=0.3
MAYA_PROFIT_TRAIL_R=1.0
MAYA_PROFIT_TRAIL_START_R=2.0

# Hyperliquid through the official SDK (MAYA_VENUE=hyperliquid). "mm" keeps
# the MetaMask CLI path. Testnet unless MAYA_MODE=live, MAYA_LIVE_CONFIRM and
# BOTH mainnet values below are set.
MAYA_HL_BROKER=mm
MAYA_HL_MAINNET=false
MAYA_HL_MAINNET_CONFIRM=
MAYA_HL_ENTRY_TIMEOUT_S=20
# Testnet only: scale order prices by testnet mid / real mid at entry. The
# testnet trades at its own price (BTC was 4 to 136 bps under the real one).
MAYA_HL_TESTNET_PRICE_MAP=true
# API wallet key (trade only, cannot withdraw) and your main account address.
# Never the main wallet's private key.
HL_API_WALLET_KEY=
HL_ACCOUNT_ADDRESS=

# Kronos forecast input for Iris. Off by default. Needs a clone of
# github.com/shiyu-coder/Kronos with its requirements installed.
MAYA_KRONOS_ENABLED=false
MAYA_KRONOS_REPO_PATH=
MAYA_KRONOS_TIMEFRAME=15m
MAYA_KRONOS_LOOKBACK=256
MAYA_KRONOS_PRED_LEN=4
MAYA_KRONOS_SAMPLES=3
MAYA_KRONOS_MARGIN_BPS=5

# Paper entry simulation: immediate (fill at once) or post_only (rest the
# order; fill only if price trades through, with the probability below).
MAYA_PAPER_ENTRY_MODE=immediate
MAYA_MAKER_FILL_PROBABILITY=0.6
MAYA_MAKER_ORDER_TTL_CANDLES=1
MAYA_MAKER_ADVERSE_HORIZON_CANDLES=5
MAYA_MAKER_SEED=7

# Flipped-CVD setups: sweep and compression breakout with the delta
# confirmation reversed. Unmeasured, off by default.
MAYA_CVD_FLIP_SETUPS_ENABLED=false
# Run only these setups (comma-separated names). Blank = normal selection.
MAYA_SETUPS_ONLY=

# Multi-timeframe layers. Both unmeasured, both off by default.
# Bias filter: setups fire only in the direction of the 15m bias.
MAYA_MTF_BIAS_FILTER_ENABLED=false
# 15s trigger: needs MAYA_USE_WEBSOCKET=true for tick data.
MAYA_MTF_15S_TRIGGER_ENABLED=false

# Lessons veto. Before an entry, past trades of the same setup and direction
# in a similar context are checked; with enough of them and a win rate under
# the minimum, the entry is skipped. It can only remove trades.
MAYA_LESSONS_VETO_ENABLED=true
MAYA_LESSONS_SIMILARITY=0.75
MAYA_LESSONS_MIN_MATCHES=5
MAYA_LESSONS_MIN_WIN_RATE=0.2

# Leverage used for orders. Rejected (not clamped) above RiskLimits.MAX_LEVERAGE=10.
# At 10x liquidation sits about 8.75% away, and stops wider than 7% are refused.
MAYA_LEVERAGE=10

# Minimum expected ROI **on margin** (price move x leverage), not the raw price
# move. Screening the unleveraged move against 40% rejected every realistic 1m
# scalp — BTC does not move 40% intraday. Note this makes the gate
# leverage-dependent: the same setup can clear 40% at 10x but not at 5x.
MAYA_MIN_ROI_PCT=40

# ---- Hyperliquid tuning (only when MAYA_VENUE=hyperliquid) ----------------
# limit enters at the strategy's entry price, preserving planned R:R;
# market fills immediately and silently changes it.
MAYA_PERPS_ORDER_TYPE=limit
# Venue size precision. 5 is correct for BTC — check `mm perps markets` first
# for anything else; Hyperliquid rejects orders with too many size decimals.
MAYA_PERPS_SIZE_DECIMALS=5
MAYA_PERPS_MAX_SLIPPAGE_BPS=50
# Per-`mm`-call timeout. Generous because each call spawns Node and may wait
# on wallet signing/MFA; a timeout leaves order state genuinely UNKNOWN.
MAYA_MM_TIMEOUT_S=120
# --wallet-timeout for signing commands (open/close/modify/cancel): how long the
# CLI waits on a wallet job such as a Guard Mode approval. Max 600, and must be
# below MAYA_MM_TIMEOUT_S so the CLI reports a stall before Maya kills it.
MAYA_MM_WALLET_TIMEOUT_S=90
# The CLI's Segment/Sentry analytics. Off by default: with it on, a call was
# measured hanging 100s+ after printing its result (1.7s with it off).
MAYA_MM_TELEMETRY=false
# Rehearsal: validate + quote every order on Hyperliquid, never sign or submit.
# MetaMask: testnet can't be funded through Agent Wallet, so rehearse on
# mainnet this way (MAYA_MODE=live still needs MAYA_LIVE_CONFIRM).
MAYA_PERPS_DRY_RUN=false
# Size every order at Hyperliquid's $10 minimum (~$10.50) — real orders,
# tiny stakes. The step between a dry run and normal sizing.
MAYA_PERPS_MIN_SIZE=false
# Pin the agent wallet. Google / email / Mobile QR sign-ins each resolve to a
# different address; the preflight refuses any wallet but this one.
MAYA_MM_EXPECTED_ADDRESS=
# A limit entry that comes back "resting" is waited on this long, then
# cancelled, so an unfilled entry never sits on the book without a stop.
MAYA_PERPS_LIMIT_FILL_TIMEOUT_S=15
MAYA_PERPS_FILL_POLL_S=3
# MetaMask Pulse: AI market summaries passed to the LLM veto as context.
# Needs MAYA_LLM_ENABLED=true and a signed-in `mm` session.
MAYA_PULSE_ENABLED=false
MAYA_PULSE_TTL_S=900

# ---- Real-time data (optional) ---------------------------------------------
# false (default): REST polling via ccxt, boundary-aligned (maya/data/scheduler.py)
# true: subscribe to Binance kline + aggTrade WebSocket streams directly
#       (opt-in — see docs/RUNNING.md "Real-time WebSocket feed")
MAYA_USE_WEBSOCKET=false

# ---- Backtesting (python -m maya.backtest.runner) --------------------------
# ISO dates for the historical range to fetch/replay. Uses MAYA_SYMBOL /
# MAYA_TIMEFRAME above. Historical klines are cached to CSV under data/.
MAYA_BACKTEST_START=2025-01-01
MAYA_BACKTEST_END=2025-12-31

# ---- LIVE TRADING SAFETY INTERLOCK ----------------------------------------
# Live trading is refused unless this is set to the exact string: I_UNDERSTAND_THE_RISK
MAYA_LIVE_CONFIRM=

# ---- Binance API credentials (only needed for paper/testnet/live) ---------
# Use a key with FUTURES permission ONLY. Never enable withdrawals. IP-whitelist it.
# Before running the agent itself, sanity-check these with:
#   python -m maya.check_connection
# (read-only: checks keys, clock sync, balance, position mode — places no orders)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Setups -------------------------------------------------------------------
# Setup 3 (compression breakout) is built to spec but has never been measured
# and uses the CVD sign the README's study found inverted. Enable only after
# `python -m maya.backtest.sweep` shows it paying after fees.
MAYA_COMPRESSION_BREAKOUT_ENABLED=false

# ---- Fees & the fee gate -----------------------------------------------------
# Blank = venue defaults (Hyperliquid maker 1.5 / taker 4.5bps + MetaMask
# builder fee assumed at the 10bps cap), replaced at startup by the real
# figures from `mm perps quote`. Set to pin your own.
# MAYA_FEE_MAKER_BPS=
# MAYA_FEE_TAKER_BPS=
# MAYA_BUILDER_FEE_BPS=
# A trade must keep this R:R after the round trip, and fees may take at most
# this share of the move to target.
MAYA_MIN_NET_RR=2.5
MAYA_MAX_FEE_SHARE=0.20

# ---- Multi-coin scanner (python -m maya.scanner / maya.scan_run) ------------
MAYA_SCAN_MAX_COINS=15
MAYA_SCAN_MIN_VOLUME_USD=20000000
MAYA_SCAN_LOOKBACK=400
# Pin a list instead of the volume-ranked universe, e.g. BTC,ETH,SOL
MAYA_SCAN_SYMBOLS=
MAYA_SCAN_DESK_VETO=true

# ---- Optional LLM confluence / veto layer (Layer 3.4) ---------------------
# When true, an LLM acts as a final veto on trades that already passed the rules.
# It can only REJECT trades, never originate them.
MAYA_LLM_ENABLED=false
ANTHROPIC_API_KEY=
MAYA_LLM_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — a veto rarely needs more than low.
MAYA_LLM_EFFORT=low

# ---- Monitoring API + phone apps (ios/, android/) ---------------------------
# Off by default: it puts a trading system on a network socket. The server
# refuses to start without a token. 127.0.0.1 is this machine only; 0.0.0.0
# lets a phone on the same Wi-Fi reach it (and anything else on that network).
MAYA_API_ENABLED=false
MAYA_API_HOST=127.0.0.1
MAYA_API_PORT=8787
# Make one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
MAYA_API_TOKEN=

# ---- Telegram bot (alerts + /status /trades /chart /halt) -----------------
# Off by default. 1) @BotFather -> /newbot, paste the token below.
# 2) Message your bot once. 3) python -m maya.check_telegram prints your chat
# id; put it below. 4) python -m maya.check_telegram --send to test.
# The bot answers only these chats and refuses to start without them.
MAYA_TELEGRAM_ENABLED=false
MAYA_TELEGRAM_BOT_TOKEN=
MAYA_TELEGRAM_CHAT_IDS=
# Seconds between checks for opened/closed trades and halts.
MAYA_TELEGRAM_POLL_S=5
# Attach a chart (entry/SL/TP and drawings) to "position opened" alerts.
MAYA_TELEGRAM_CHART_ON_OPEN=true
# Message after 00:00 UTC with the previous day's trades and P&L
MAYA_TELEGRAM_DAILY_SUMMARY=true

# ---- Logging --------------------------------------------------------------
MAYA_LOG_LEVEL=INFO
