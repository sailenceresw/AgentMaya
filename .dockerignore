# Secrets & local config — never bake into the image
.env

# VCS / CI
.git
.github
.gitignore

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Not needed at runtime
tests/
docs/
android/
ios/
tools/

# Runtime artifacts
data/
*.db
*.sqlite*
logs/
*.log
*.png
*.csv
