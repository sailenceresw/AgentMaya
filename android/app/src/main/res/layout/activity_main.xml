<?xml version="1.0" encoding="utf-8"?>
<!--
  Phone-first single column. Two panels live here and only one is visible at a
  time: `setup` for entering the agent's address, `dashboard` for everything
  else. Keeping them in one Activity avoids navigation state to get wrong when
  the connection drops.

  The cards hold empty `Rows` containers; MainActivity fills them with
  label/value rows, trade rows and scan rows (the Figma "Android" components)
  so values can be coloured individually instead of living in one text block.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:fitsSystemWindows="true">

    <!-- ============================ SETUP ============================ -->
    <ScrollView
        android:id="@+id/setup"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:paddingTop="28dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect to Maya"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:paddingBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Watch your trading agent from your phone. Both devices must be on the same Wi-Fi."
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                android:paddingBottom="12dp" />

            <TextView style="@style/Label" android:text="Host (agent's LAN IP)" />
            <EditText
                android:id="@+id/host"
                style="@style/Input"
                android:hint="192.168.1.24"
                android:inputType="textUri"
                android:autofillHints="" />

            <TextView style="@style/Label" android:text="Port" />
            <EditText
                android:id="@+id/port"
                style="@style/Input"
                android:text="8787"
                android:inputType="number"
                android:autofillHints="" />

            <TextView style="@style/Label" android:text="API token" />
            <EditText
                android:id="@+id/token"
                style="@style/Input"
                android:hint="MAYA_API_TOKEN"
                android:inputType="textPassword"
                android:autofillHints="" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Start the agent with MAYA_API_ENABLED=true and MAYA_API_HOST=0.0.0.0. The token is MAYA_API_TOKEN from its .env."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/setupError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/negative"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/connect"
                style="@style/PillButton"
                android:layout_marginTop="28dp"
                android:background="@drawable/btn_filled"
                android:textColor="#FFFFFFFF"
                android:text="Connect" />
        </LinearLayout>
    </ScrollView>

    <!-- ========================== DASHBOARD ========================== -->
    <LinearLayout
        android:id="@+id/dashboard"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Top app bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingLeft="16dp"
            android:paddingRight="4dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maya"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />

                <TextView
                    android:id="@+id/configPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="connecting…"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:singleLine="true"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/settings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⚙"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Connection settings" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Equity -->
                <LinearLayout style="@style/Card" android:paddingBottom="14dp">
                    <TextView style="@style/CardTitle" android:text="EQUITY" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/equity"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:textColor="@color/text_primary"
                            android:textSize="34sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <!-- State badge: dot + RUNNING / COOLDOWN / HALTED -->
                        <LinearLayout
                            android:id="@+id/stateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/pill_raised"
                            android:paddingLeft="10dp"
                            android:paddingRight="12dp"
                            android:paddingTop="5dp"
                            android:paddingBottom="5dp">

                            <View
                                android:id="@+id/stateDot"
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:layout_marginRight="6dp"
                                android:background="@drawable/dot" />

                            <TextView
                                android:id="@+id/state"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.05" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/pnl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/haltReasons"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/negative"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Position -->
                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="OPEN POSITION" />
                    <LinearLayout android:id="@+id/position" style="@style/Rows" />
                </LinearLayout>

                <!-- Run stats -->
                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="THIS RUN" />
                    <LinearLayout android:id="@+id/stats" style="@style/Rows" />
                </LinearLayout>

                <!-- Trades -->
                <LinearLayout style="@style/Card">
                    <TextView style="@style/CardTitle" android:text="RECENT TRADES" />
                    <LinearLayout android:id="@+id/trades" style="@style/Rows" />
                </LinearLayout>

                <!-- Scanner (only when the scanner agent is running) -->
                <LinearLayout
                    android:id="@+id/scanCard"
                    style="@style/Card"
                    android:visibility="gone">
                    <TextView style="@style/CardTitle" android:text="LAST SCAN" />
                    <TextView
                        android:id="@+id/scanNote"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:paddingBottom="4dp" />
                    <LinearLayout android:id="@+id/scan" style="@style/Rows" />
                </LinearLayout>

                <Button
                    android:id="@+id/halt"
                    style="@style/PillButton"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/btn_danger_tonal"
                    android:textColor="@color/negative"
                    android:text="Halt trading" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Halting stops new trades. It does not close an open position — do that on the exchange."
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:paddingLeft="4dp"
                    android:paddingRight="4dp" />

                <TextView
                    android:id="@+id/footer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="12dp"
                    android:paddingBottom="20dp"
                    android:gravity="center"
                    android:textColor="@color/text_hint"
                    android:textSize="12sp" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
