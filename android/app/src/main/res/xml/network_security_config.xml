<?xml version="1.0" encoding="utf-8"?>
<!--
  The agent runs on your own machine and serves plain HTTP over the LAN, so
  cleartext has to be permitted. It is permitted for every host: a
  network-security-config <domain> matches host *names*, not IP ranges, so an
  entry like 192.168.0.0 only ever matched that one literal address and could
  not scope this to private networks. (An earlier version listed such entries
  and claimed it did.) Only enter your agent's LAN address in the app: the API
  token travels unencrypted.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
